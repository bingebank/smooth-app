{
  "$meta": {
    "name": "My Health Scanner — design tokens",
    "canvas": { "width": 375, "height": 812, "note": "iOS logical pixels. Values are Flutter logical pixels 1:1." },
    "usage": "Source of truth for public/screens.css and for the Flutter theme. Change a value here, change it in both."
  },

  "color": {
    "green900": "#143A2B",
    "green800": "#1A4534",
    "green700": "#204C3B",
    "green600": "#2A6349",
    "green500": "#3B7F5E",
    "mint500": "#63C7A6",
    "mint300": "#9BDCC2",
    "mint100": "#E3F4EC",

    "cream": "#F8F8F3",
    "cream2": "#F1F3EA",
    "surface": "#FFFFFF",
    "line": "#E2E6DC",

    "ink": "#17291F",
    "ink2": "#4A5A50",
    "ink3": "#7B8981",

    "gold": "#D9A03C",
    "gold100": "#FBF1DD",
    "goldInk": "#8A6218",

    "rose": "#C0453F",
    "rose100": "#FBEAE9",

    "scoreGood": "#2A9D6E",
    "scoreFair": "#E0A33A",
    "scorePoor": "#C0453F",
    "track": "#EDF1EC"
  },

  "type": {
    "family": {
      "display": "Fraunces, Georgia, serif",
      "text": "Inter, -apple-system, system-ui, sans-serif"
    },
    "statusBar":   { "size": 15, "weight": 600, "lineHeight": 20 },
    "navTitle":    { "size": 17, "weight": 600, "lineHeight": 22 },
    "screenTitle": { "size": 22, "weight": 600, "lineHeight": 28 },
    "sectionHead": { "size": 16, "weight": 600, "lineHeight": 22 },
    "productName": { "size": 20, "weight": 600, "lineHeight": 26 },
    "body":        { "size": 15, "weight": 400, "lineHeight": 21 },
    "bodyStrong":  { "size": 15, "weight": 600, "lineHeight": 21 },
    "label":       { "size": 13, "weight": 500, "lineHeight": 18 },
    "caption":     { "size": 12, "weight": 400, "lineHeight": 16 },
    "chip":        { "size": 12, "weight": 600, "lineHeight": 16 },
    "scoreValue":  { "size": 28, "weight": 600, "lineHeight": 30 },
    "button":      { "size": 16, "weight": 600, "lineHeight": 20 }
  },

  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "3xl": 32 },

  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 20, "pill": 999, "device": 44 },

  "size": {
    "statusBarHeight": 44,
    "navBarHeight": 52,
    "screenPadding": 20,
    "buttonHeight": 52,
    "rowHeight": 44,
    "iconSm": 16,
    "iconMd": 20,
    "iconLg": 24,
    "scoreRing": 88,
    "scoreRingStroke": 8
  },

  "elevation": {
    "card": "0 1px 2px rgba(20,58,43,.05), 0 4px 12px rgba(20,58,43,.06)",
    "raised": "0 2px 8px rgba(20,58,43,.08), 0 12px 28px rgba(20,58,43,.10)"
  },

  "semantic": {
    "safe":  { "bg": "mint100", "fg": "green700" },
    "limit": { "bg": "gold100", "fg": "goldInk" },
    "avoid": { "bg": "rose100", "fg": "rose" }
  }
}
